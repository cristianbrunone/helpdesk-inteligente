<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Bogus" />
    <!-- Abstração de LLM e adaptador OpenAI-compatível (ADR-0005). -->
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelpDesk.Application\HelpDesk.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prompts versionados (prompts/*.md): copiados para a saída de quem referencia a Infrastructure (Api, Worker). -->
    <None Include="..\..\prompts\*.md" Link="prompts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os testes de integração exercitam as consultas diretamente (ex.: EXPLAIN da busca). -->
    <InternalsVisibleTo Include="HelpDesk.IntegrationTests" />
    <!-- Cálculo do backoff e classificação de falhas da resiliência, testados sem I/O. -->
    <InternalsVisibleTo Include="HelpDesk.UnitTests" />
  </ItemGroup>
</Project>
