# =============================================================
# HelpDesk Inteligente — variáveis de ambiente
# O docker compose sobe SEM .env: todos os valores abaixo já são o padrão do docker-compose.yml.
# Para sobrescrever algo, copie este arquivo para .env (que está no .gitignore) e edite.
# Uma linha vazia (CHAVE=) significa "não configurado": vale o padrão. Valor inválido impede o serviço de subir.
# NUNCA coloque chaves reais neste arquivo: ele é versionado.
# =============================================================

# ---------- Banco (Sprint 0) ----------
POSTGRES_USER=helpdesk
# Senha só para desenvolvimento local.
POSTGRES_PASSWORD=helpdesk_dev
POSTGRES_DB=helpdesk

# ---------- Portas no host (Sprint 0) ----------
WEB_PORTA_HOST=8080
API_PORTA_HOST=5080
DB_PORTA_HOST=55432

# ---------- Rede com inspeção TLS (opcional, Sprint 0) ----------
# Só para quem está atrás de um proxy corporativo que intercepta HTTPS (o build falha com "UntrustedRoot").
# Caminho para a CA raiz do proxy em formato PEM, FORA do repositório. Usada só durante o build das imagens.
# Exemplo: CA_EXTRA_PEM=C:/Users/voce/.certs/ca-corporativa.pem
CA_EXTRA_PEM=

# ---------- Worker (Sprint 0) ----------
WORKER_HEARTBEAT_INTERVAL_SECONDS=30

# ---------- Provedor de IA (ADR-0005; usado a partir da Sprint 2) ----------
# fake | openai-compatible. O padrão é fake: roda sem chave de API.
LLM_PROVIDER=fake
# Exemplo para o Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
# A chave fica só no seu .env local. Nunca no repositório.
LLM_API_KEY=
# Modelos validados na PoC (ADR-0005): gemini-3.5-flash-lite (500 req/dia no free tier) e gemini-embedding-001.
LLM_CHAT_MODEL=gemini-3.5-flash-lite
LLM_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Tempo máximo de cada tentativa e novas tentativas para falhas transitórias (429, 5xx, timeout).
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Só para o fake (testes e demonstração): normal | lento | json_invalido | categoria_inexistente | rate_limit.
LLM_FAKE_MODO=normal
# Atraso do modo "lento", em milissegundos.
LLM_FAKE_ATRASO_MS=30000

# ---------- Kill switches e orçamentos de IA (ADR-0021; Sprints 2 e 4) ----------
# true | false. Desligada, o chamado nasce sem triagem e o Worker para de consumir a fila (procedimento de emergência).
IA_TRIAGEM_HABILITADA=true
IA_COPILOTO_HABILITADO=true
# Limite de tokens da resposta da triagem (vazio = 800). Resposta cortada vira triagem Falhou.
TRIAGEM_MAX_TOKENS_SAIDA=
COPILOTO_MAX_TOKENS_SAIDA=

# ---------- Fila e reconciliação (ADR-0003, ADR-0010; Sprints 2 e 3) ----------
WORKER_POLL_INTERVAL_MS=1500
WORKER_BATCH_SIZE=5
WORKER_RECONCILE_INTERVAL_SECONDS=30

# ---------- RAG (ADR-0011; Sprint 3) ----------
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.35

# ---------- Copiloto (Sprint 4) ----------
COPILOTO_RATE_LIMIT_POR_MINUTO=10

# ---------- Tracing (ADR-0019; Sprint 2, opcional) ----------
# Sem valor, não há exportação. Com o profile "observabilidade": http://aspire-dashboard:18889
OTEL_EXPORTER_OTLP_ENDPOINT=
