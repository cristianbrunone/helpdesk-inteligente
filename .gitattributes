# =============================================================
# HelpDesk Inteligente — .gitattributes
# O repositório guarda todo texto com LF (Linux/Docker).
# =============================================================

# Padrão: detectar texto e normalizar para LF
* text=auto eol=lf

# Código e configuração (explícito, por clareza)
*.cs        text eol=lf diff=csharp
*.csproj    text eol=lf
*.sln       text eol=lf
*.slnx      text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sql       text eol=lf
*.md        text eol=lf diff=markdown
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
Dockerfile  text eol=lf
.env.example text eol=lf

# Scripts nativos do Windows mantêm CRLF
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binários (sem conversão nem diff textual)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.dll   binary
*.exe   binary

# Arquivos gerados: marcados para colapsar no diff do GitHub
**/Migrations/*.Designer.cs     linguist-generated=true
**/Migrations/*ModelSnapshot.cs linguist-generated=true
web/package-lock.json           linguist-generated=true
