# =============================================================
# HelpDesk Inteligente — .editorconfig
# Lido pelo VS Code, pelo compilador e pelo `dotnet format` (CI).
# =============================================================
root = true

# ---------- Todos os arquivos ----------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: espaço duplo no fim da linha é quebra de linha intencional
[*.md]
trim_trailing_whitespace = false

# Scripts do Windows
[*.{cmd,bat,ps1}]
end_of_line = crlf

# XML de projeto .NET
[*.{csproj,props,targets,xml,slnx}]
indent_size = 2

# SQL (consultas explícitas do dashboard, ADR-0009)
[*.sql]
indent_size = 2

# ---------- C# ----------
[*.cs]
indent_size = 4
max_line_length = 120

# Organização
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning

# Chaves e quebras de linha (estilo padrão .NET)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = when_multiline:suggestion

# var: onde o tipo é evidente
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Preferências modernas
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

# Modificadores de acesso sempre explícitos
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# ---------- Convenções de nomes ----------
# Interfaces: prefixo I (IChamadoRepository, IFilaTriagem)
dotnet_naming_rule.interfaces_com_i.symbols = interfaces
dotnet_naming_rule.interfaces_com_i.style = prefixo_i
dotnet_naming_rule.interfaces_com_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.prefixo_i.required_prefix = I
dotnet_naming_style.prefixo_i.capitalization = pascal_case

# Tipos, métodos e propriedades: PascalCase
dotnet_naming_rule.tipos_e_membros_pascal.symbols = tipos_e_membros
dotnet_naming_rule.tipos_e_membros_pascal.style = pascal
dotnet_naming_rule.tipos_e_membros_pascal.severity = warning
dotnet_naming_symbols.tipos_e_membros.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_style.pascal.capitalization = pascal_case

# Campos privados: _camelCase
dotnet_naming_rule.campos_privados.symbols = campos_privados
dotnet_naming_rule.campos_privados.style = underline_camel
dotnet_naming_rule.campos_privados.severity = warning
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.underline_camel.required_prefix = _
dotnet_naming_style.underline_camel.capitalization = camel_case

# Constantes: PascalCase
dotnet_naming_rule.constantes.symbols = constantes
dotnet_naming_rule.constantes.style = pascal
dotnet_naming_rule.constantes.severity = warning
dotnet_naming_symbols.constantes.applicable_kinds = field
dotnet_naming_symbols.constantes.required_modifiers = const

# Métodos assíncronos: sufixo Async
dotnet_naming_rule.metodos_async.symbols = metodos_async
dotnet_naming_rule.metodos_async.style = sufixo_async
dotnet_naming_rule.metodos_async.severity = suggestion
dotnet_naming_symbols.metodos_async.applicable_kinds = method
dotnet_naming_symbols.metodos_async.required_modifiers = async
dotnet_naming_style.sufixo_async.required_suffix = Async
dotnet_naming_style.sufixo_async.capitalization = pascal_case

# ---------- Diagnósticos ----------
# CancellationToken deve ser propagado (regra do CLAUDE.md)
dotnet_diagnostic.CA2016.severity = warning
# Não usar .Result/.Wait() em código assíncrono
dotnet_diagnostic.CA1849.severity = warning
# Logs com template estruturado, nunca interpolação (logs estruturados, NFR-11)
dotnet_diagnostic.CA2254.severity = warning

# ---------- Testes: regras mais flexíveis ----------
[tests/**/*.cs]
# Nomes no padrão Metodo_Cenario_ResultadoEsperado usam underscore
dotnet_naming_rule.tipos_e_membros_pascal.severity = none
dotnet_diagnostic.CA1707.severity = none
# Testes async não precisam do sufixo Async
dotnet_naming_rule.metodos_async.severity = none
